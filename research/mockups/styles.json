        3,
        2
      ],
      "offroadXWidth": [
        2,
        1
      ]
    },
    "gaps": {
      "name": "4. Open gaps",
      "note": "Road cut into class-coloured pieces with see-through gaps: long pieces = Unpaved; long and short pieces, like the Carto track dash-dot = Off-road.",
