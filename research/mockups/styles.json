      "offroadShift": [
        21,
        37
      ]
    },
    "dashes": {
      "name": "3. Dashes",
      "note": "Unpaved: long dashes, dash 3 x and gap 2 x road width (Americana: 4 x and 4 x), darker tint of the class colour (light brown on white). Off-road: dash 2 x, gap 1 x road width.",
